<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shelters</title>
    <link rel="stylesheet" href="/styles/css/style.css">
</head>
<body>
    
    <main>
        
        <% for(let shelter of shelters){ %>
            <table>
                <caption><%= shelter.name %></caption>

                <% if(shelter.animals.length > 0){%>
                    <thead>
                        <th>Animal name</th>
                        <th>Animal age</th>
                        <th>Animal birthday</th>
                    </thead>

                    <tbody>
                        <%for(let animal of shelter.animals) {%>
                            <tr>
                                <td><%=animal.name%></td>
                                <td><%=animal.age%></td>
                                <td><%=animal.birthday%></td>
                            </tr>
                        <%}%>
                    </tbody>
                <%} else { %>
                    <th colspan="3">Nincs állat a menhelyen</th>
                <%}%>
            </table>
        <%}%>

        <%- include("../../partials/footer"); %>

    </main>

</body>
</html>