<Window x:Class="_2026_01_26_HttpClient_Filmek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_01_26_HttpClient_Filmek"
        mc:Ignorable="d"        
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:FilmekViewModel x:Name="ViewModel"/>
    </Window.DataContext>
    <StackPanel>
        <GroupBox Margin="10">
            <StackPanel>
                <Label Content="Cím"/>
                <TextBox x:Name="TxtCim"/>
                <Label Content="Hossz"/>
                <TextBox x:Name="TxtHossz"/>
                <Label Content="Értékelés"/>
                <TextBox x:Name="TxtErtekeles"/>
                <Button Content="Mentés" Click="Button_Click" Margin="10"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBox x:Name="TxtDeleteCim" Width="150" Margin="10,0" />
            <Button Content="Törlés"
                    Click="DeleteButton_Click"
                    Margin="10,0"/>

        </StackPanel>
        <DataGrid ItemsSource="{Binding Filmek}"/>

    </StackPanel>
</Window>
